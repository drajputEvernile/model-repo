# Local working notes — kept on disk, not published
CLAUDE.md
PLAN.md

# Ad-hoc Azure connectivity check (not part of the pipeline)
check_azure_openai.py
/requirements.txt

# Chart workspace + manifests written by the pipeline / local runs.
# Keep the directory shells empty in git (.gitkeep / README only).
review-ui/data/folders/*
!review-ui/data/folders/.gitkeep
review-ui/data/metadata/*
!review-ui/data/metadata/.gitkeep
review-ui/data/pipeline/*
!review-ui/data/pipeline/README.md

# Editor / agent local config (skills live in ~/.cursor and ~/.claude)
.claude/
.cursor/

# Downloaded ML checkpoints — keep local, never commit (~GBs).
# Includes HW ConvNeXt, RapidOCR, GLiNER NER, and anything under models/.
# MiniLM (section headers) lives in the HuggingFace cache, not here.
/models/
core-pipeline/models/**
!core-pipeline/models/README.md
!core-pipeline/models/blank-junk/
!core-pipeline/models/blank-junk/**
# DistilBERT blank/junk weights (~270 MB). Copy b_jnk/models/bert_page here; do not commit.
core-pipeline/models/blank-junk/bert_page/
# The negation above re-includes macOS AppleDouble files; exclude them again.
core-pipeline/models/blank-junk/._*
# Trained extraction ranker (~1 MB of LightGBM text). The GLiNER and Heron weights beside it
# stay ignored: gliner_low/ and layout_heron/ are copied in or fetched by util/model_setup.py.
!core-pipeline/models/kv_ranker/
!core-pipeline/models/kv_ranker/**
*.safetensors
*.onnx
*.bin
*.pth
*.pkl

# Daily pipeline logs (core-pipeline/logs/)
core-pipeline/logs/**
!core-pipeline/logs/README.md
*.log

# Standalone managed-identity connection test. Its .env is committed on
# purpose — it holds the identity's client/principal IDs and blanks, never a
# key, a connection string or a SAS token. The venv is not.
test-connection/.venv/
!test-connection/.env

# Extraction training tools' working data (reviewed runs, datasets); the pipeline never writes it.
core-pipeline/data/
