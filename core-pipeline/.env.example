# core-pipeline — copy to .env and fill in.
# Only variables the code reads. Every path below is relative to core-pipeline/.

# --- Database (shared with review-ui) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imaging_outputs
DB_POOL_MIN=1
DB_POOL_MAX=20

# --- Workspace (same paths review-ui mounts) ---
DATA_ROOT=../review-ui/data/folders
METADATA_ROOT=../review-ui/data/metadata

# --- API ---
API_HOST=0.0.0.0
API_PORT=8001

# --- Workers (BATCH_WORKERS × STAGE_WORKERS + BATCH_POOL_HEADROOM ≤ DB_POOL_MAX) ---
STAGE_WORKERS=4
BATCH_WORKERS=4
# For Docling double-free / heap corruption: set BATCH_WORKERS=1 to prove
# concurrency. If crashes stop at 1 and return at 4, keep 1 until Final1 is
# isolated (process pool / RapidOCR-only fallback under load).
BATCH_POOL_HEADROOM=2

# Native crash diagnostics (Docling / ONNX / OpenMP). faulthandler dumps a
# Python traceback to stderr on abort — visible in `docker compose logs`.
# OMP_NUM_THREADS=1 stops OpenMP pools inside Torch/ONNX fighting each other.
PYTHONFAULTHANDLER=1
OMP_NUM_THREADS=1

# --- Model files ---
# All of these are relative to core-pipeline/. Copy the weight folders into
# core-pipeline/models/ (Windows and the Linux VM use the same values).
# Docker mounts that folder at /app/core-pipeline/models.
#
#   models/hw/handwritten_printed_convnext_tiny.pth
#   models/rapidocr/          (four RapidOCR files)
#   models/semantic-model/    (MiniLM)
#   models/blank-junk/tfidf_flat.joblib + default.json
#   models/gliner_low/        (GLiNER, key/value extraction)
#   models/layout_heron/      (Heron heading detector)
#   models/kv_ranker/v002/    (trained extraction ranker)

# --- Stage 1: handwriting + rotation ---
HW_MODEL_PATH=models/hw/handwritten_printed_convnext_tiny.pth
ROTATION_CORRECTION_ENABLED=true
TESSERACT_CMD=

# --- Stage 4 final1 (Docling / RapidOCR) ---
# Defaults (omit): TABLE_MODE=fast, DO_TABLES=true, EXPORT_DOCUMENT=false, IMAGES_SCALE=1.0.
# Cell matching off by default (speed). On timeout/sparse → RapidOCR-onnx.
# Docling convert is process-wide serial — BATCH_WORKERS may stay >1 for other
# stages; Final1 pages queue on one Torch convert at a time.
RAPID_MODELS_DIR=models/rapidocr
DOCLING_WORKERS=1
DOCLING_PAGE_TIMEOUT_SECONDS=90
DOCLING_TABLE_CELL_MATCHING=false
SECTION_HEADER_SEMANTIC_ENABLED=true
SECTION_HEADER_SEMANTIC_THRESHOLD=0.90
SECTION_HEADER_MINILM_PATH=models/semantic-model

# --- Blank/junk. Directory holds tfidf_flat.joblib + default.json.
# Optional DistilBERT: copy b_jnk/models/bert_page into this directory as bert_page/.
# Needs torch and transformers; otherwise the TF-IDF file is used.
# Missing file ⇒ regex rules only.
BLANK_JUNK_MODEL_DIR=models/blank-junk

# --- Azure Blob (intake + manifest sweep) ---
# Auth: key | entra | entra_interactive | managed_identity
AZURE_STORAGE_AUTH=entra
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=imaging-pipeline
AZURE_CLIENT_ID=
AZURE_PRINCIPAL_ID=
AZURE_BLOB_CONNECTION_POOL_SIZE=50
AZURE_RETRY_ATTEMPTS=5
AZURE_RETRY_BASE_DELAY=1.0
AZURE_RETRY_MAX_DELAY=30.0

# --- Stage 5 final2 (Azure Document Intelligence — billed) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_POLL_TIMEOUT_SECONDS=180
AZURE_DI_FEATURES=languages,barcodes
AZURE_DI_CONNECTION_POOL_SIZE=32
AZURE_DI_MAX_CONCURRENT=4

PAGE_CLASSIFY_DEBUG=false
ENCOUNTER_DEBUG=false

# --- Key/value extraction (right after OCR; member, DOS, headings, page numbers) ---
# Weights live under EXTRACTION_MODELS_ROOT (relative to core-pipeline/). A missing
# folder or an unknown version fails the stage, naming what is missing.
EXTRACTION_MODELS_ROOT=models
# Training tools only: reviewed runs / OCR / images in, datasets out. The pipeline never writes here.
# EXTRACTION_DATA_ROOT=data/extraction

# Page sequencing: optional cross-encoder ONNX (default off = markers/headers).
SEQUENCING_CROSS_ENCODER=false

# --- Behaviour ---
# When true: reuse OCR if the *output folder* (or workspace) ocr/ has files,
# else write the three ocr/ files from ocr_results. If neither exists, OCR runs.
# With skip_ocr + force=false on run: refresh quality; reuse OCR; force-re-run
# every non-OCR stage (blank/junk, extraction, member, DOS, …). Gate-delta may
# still reopen OCR engines for a page whose path flipped or OCR is missing.
# force=true on run/batch always re-OCRs.
SKIP_OCR=false
# Batch: charts with more than this many pages run strictly one at a time.
# LARGE_CHART_MIN_PAGES=500
# Quiet Azure HTTP dumps and Docling convert INFO (WARNING keeps real failures).
# Set INFO/DEBUG to bring the dumps back when diagnosing a 403 or throttle.
AZURE_LOG_LEVEL=WARNING
# Daily file logs under LOG_DIR (default ./logs). Still mirrored to stdout.
LOG_TO_FILE=true
# LOG_DIR=
LOG_BACKUP_DAYS=30
# Colour [batch-N] / [page-N] tags in the terminal (auto|true|false).
LOG_COLOR=auto
